{
  "id": "map_demo",
  "steps": [
    {
      "id": "read",
      "type": "read_documents",
      "store": "input_store",
      "output": "docs"
    },
    {
      "id": "map",
      "type": "map_agent",
      "input": "docs",
      "output": "out",
      "agent_config": {
        "system": "Summarize briefly.",
        "output_id": "summary.md"
      }
    },
    {
      "id": "write",
      "type": "write_documents",
      "input": "out",
      "store": "output_store"
    }
  ]
}
